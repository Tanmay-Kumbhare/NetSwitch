  "item": [
    {
      "name": "01 - System Health & Public Endpoints",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"System health status is ok: true\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.ok).to.eql(true);",
                  "    pm.expect(json).to.have.property('time');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Unauthenticated health endpoint to verify agent and HTTP server are responsive."
          }
        },
        {
          "name": "Get Demo Scenarios List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns 5 supported in-memory scenarios\", function () {",
                  "    var scenarios = pm.response.json();",
                  "    pm.expect(scenarios).to.be.an('array');",
                  "    pm.expect(scenarios.length).to.eql(5);",
                  "    var ids = scenarios.map(s => s.id);",
                  "    pm.expect(ids).to.include('degradation');",
                  "    pm.expect(ids).to.include('hard_failure');",
                  "    pm.expect(ids).to.include('flapping');",
                  "    pm.expect(ids).to.include('recovery_switch_back');",
                  "    pm.expect(ids).to.include('no_internet');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "scenarios"]
            },
            "description": "Returns metadata for all 5 algorithmic failover scenarios."
          }
        }
      ]
    },
    {
      "name": "02 - Authentication & Authorization",
      "item": [
        {
          "name": "Register Admin User (Bootstrap)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict (Already registered)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.test(\"Returns JWT token and user info\", function () {",
                  "        pm.expect(json).to.have.property('token');",
                  "        pm.expect(json.user).to.have.property('email');",
                  "        pm.collectionVariables.set(\"jwtToken\", json.token);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"name\": \"NetSwitch Admin\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers the initial admin user. The first user created automatically receives the admin role."
          }
        },
        {
          "name": "Login (Extract JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns valid JWT token and sets collection variable\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token.split('.').length).to.eql(3); // JWT 3-part structure",
                  "    pm.expect(json.user).to.have.property('role');",
                  "    pm.collectionVariables.set(\"jwtToken\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in and stores the signed JWT token into {{jwtToken}} for all subsequent authenticated requests."
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"JWT token correctly decoded by auth middleware\", function () {",
                  "    var user = pm.response.json();",
                  "    pm.expect(user).to.have.property('email');",
                  "    pm.expect(user).to.have.property('role');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Verifies JWT authentication and retrieves user identity."
          }
        }
      ]
    },
