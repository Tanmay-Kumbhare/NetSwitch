                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"no_internet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "run"]
            },
            "description": "Validates guard behavior when both links fail."
          }
        }
