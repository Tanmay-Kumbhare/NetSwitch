    {
      "name": "05 - In-Memory Simulation (Demo Scenarios)",
      "item": [
        {
          "name": "Run Scenario 1 - Gradual Wi-Fi Degradation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Simulation runs in memory and triggers failover\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.timeline).to.be.an('array');",
                  "    var switches = json.timeline.filter(t => t.action);",
                  "    pm.expect(switches.length).to.be.above(0);",
                  "    pm.expect(switches[0].action.reason).to.eql('degradation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"degradation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "run"]
            },
            "description": "Simulates gradual Wi-Fi packet loss/latency degradation and switching after margin + 5 checks."
          }
        },
        {
          "name": "Run Scenario 2 - Sudden Hard Failure",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Triggers immediate hard_failure switch at second 3\", function () {",
                  "    var json = pm.response.json();",
                  "    var switchFrame = json.timeline.find(t => t.action);",
                  "    pm.expect(switchFrame).to.be.an('object');",
                  "    pm.expect(switchFrame.action.reason).to.eql('hard_failure');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"hard_failure\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "run"]
            },
            "description": "Simulates 15 lost UDP probes + TCP failure triggering immediate failover."
          }
        },
        {
          "name": "Run Scenario 3 - Flapping Hold-down",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Hold-down timer suppresses rapid oscillating switches\", function () {",
                  "    var json = pm.response.json();",
                  "    var holdDownFrames = json.timeline.filter(t => t.phase === 'HOLD_DOWN');",
                  "    pm.expect(holdDownFrames.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"flapping\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "run"]
            },
            "description": "Demonstrates hold-down suppression preventing switch storms on oscillating link."
          }
        },
        {
          "name": "Run Scenario 4 - Recovery and Switch-back",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Switches back to preferred Wi-Fi adapter after 10 healthy evaluations\", function () {",
                  "    var json = pm.response.json();",
                  "    var sbFrame = json.timeline.find(t => t.action && t.action.reason === 'switch_back');",
                  "    pm.expect(sbFrame).to.be.an('object');",
                  "    pm.expect(sbFrame.action.to).to.eql('wifi');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"recovery_switch_back\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "demo", "run"]
            },
            "description": "Tests recovery evaluation and graceful return to preferred link."
          }
        },
        {
          "name": "Run Scenario 5 - Dual Link Failure (NO_INTERNET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Enters NO_INTERNET state without switching to degraded link\", function () {",
                  "    var json = pm.response.json();",
                  "    var noInternetFrames = json.timeline.filter(t => t.phase === 'NO_INTERNET');",
                  "    pm.expect(noInternetFrames.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
