# NetSwitch Backend Configuration
# Copy this file to backend/.env (loaded automatically by `npm start` on Node 22.9+).
# NOTE: backend/.env is ignored by Git and must never be committed.

PORT=4000
HOST=127.0.0.1

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=netswitch

# Operating Mode:
# NETSWITCH_MODE=windows   (default on Windows: probes real adapters and controls interface metrics)
# NETSWITCH_MODE=sim       (simulates Wi-Fi and USB tethering for testing on any OS)

# Persistence Mode:
# NETSWITCH_DB=mysql       (default: full persistence in MySQL with aggregation)
# NETSWITCH_DB=memory      (in-memory mock repository: skips MySQL for quick offline work)

# Safety & Control Authorization (defaults to false for safety):
NETSWITCH_FAILOVER_ENABLED=false
#   Default: false (Monitor-Only Mode). When false, all interface metric switching
#   (both manual via /api/control/switch and automatic via Agent decide) are strictly
#   blocked at both Agent and Controller layers. Zero Set-NetIPInterface commands will execute.
#   Set to true to authorize metric mutations.

NETSWITCH_AUTO_FAILOVER_ENABLED=false
#   Default: false. When false, the Agent's automatic decision loop (#evaluate -> decide)
#   is completely suppressed. No automated failover occurs regardless of link health or impairments.
#   When NETSWITCH_FAILOVER_ENABLED=true and NETSWITCH_AUTO_FAILOVER_ENABLED=false, the system
#   operates in MANUAL_ONLY failover mode (authorized manual switching via /api/control/switch is enabled).
#   Requires NETSWITCH_FAILOVER_ENABLED=true to take effect.

NETSWITCH_PROBE_ROUTE_PINNING=false
#   Default: false. When false, no /32 host routes are created on the Windows routing table.
#   NOTE ON WINDOWS PROBE ACCURACY: Under the Windows Weak Host Model, unpinned outbound probes
#   to public IPs follow the active default gateway. To measure physical links independently
#   without route leakage across adapters, route pinning must be explicitly enabled (requires Administrator).
