# NetSwitch Backend Configuration
# Copy this file to backend/.env (loaded automatically by `npm start` on Node 22.9+).
# NOTE: backend/.env is ignored by Git and must never be committed.

PORT=4000
HOST=127.0.0.1

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=netswitch

# Operating Mode:
# NETSWITCH_MODE=windows   (default on Windows: probes real adapters and controls interface metrics)
# NETSWITCH_MODE=sim       (simulates Wi-Fi and USB tethering for testing on any OS)

# Persistence Mode:
# NETSWITCH_DB=mysql       (default: full persistence in MySQL with aggregation)
# NETSWITCH_DB=memory      (in-memory mock repository: skips MySQL for quick offline work)
