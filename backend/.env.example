# Copy to .env (backend/.env). Loaded automatically by `npm start` (Node 22.9+).
PORT=4000
HOST=127.0.0.1
JWT_SECRET=change-me-to-a-long-random-string
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=netswitch
# NETSWITCH_MODE=windows   (default on Windows; "sim" runs the whole stack with simulated adapters)
# NETSWITCH_DB=mysql       (default; "memory" skips MySQL for quick UI work)
