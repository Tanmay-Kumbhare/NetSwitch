{
  "info": {
    "name": "NetSwitch API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Register once (first user becomes admin), then Login, then everything else. Set baseUrl if not on port 4000."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
